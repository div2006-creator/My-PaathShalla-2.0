# PostgreSQL Database Connection String
# Local Postgres: postgresql://postgres:postgres@localhost:5432/mypaathshalla?schema=public
# Cloud Postgres (Neon / Supabase / Railway): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mypaathshalla?schema=public"

# LiveKit Configuration
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"
NEXT_PUBLIC_LIVEKIT_URL="wss://YOUR_LIVEKIT_URL.livekit.cloud"

# Google Auth Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
NEXT_PUBLIC_APP_URL="https://my-paath-shalla-2-0.vercel.app"
